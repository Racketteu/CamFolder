<UserControl x:Class="CamFolder.View.MoveFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Déplacer les fichiers" 
                   FontSize="20" 
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Grid.Row="0"
                   Margin="0,0,0,20"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="auto" />
                <RowDefinition Height="20"/>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Dossier source :" 
                       Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center" />
            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" 
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="10,0,10,0"
                     MinWidth="200"/>
            <Button Content="Parcourir"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Grid.Row="0"
                    Grid.Column="2"
                    Command="{Binding BrowseSourceCommand}" 
                    Margin="10,0,0,0"/>

            <TextBlock Text="Dossier destination :" 
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"/>
            <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                     Grid.Row="2"
                    Margin="10,0,10,0"
                    Grid.Column="1"
                    MinWidth="200"/>
            <Button Content="Parcourir" 
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding BrowseDestinationCommand}" 
                    Margin="10,0,0,0"
                    Grid.Row="2"
                    Grid.Column="2"/>
            <StackPanel 
                Orientation="Vertical"
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="3">
                <RadioButton IsChecked="{Binding KeepStructure}" 
                      Content="Conserver l'arborescence actuelle" 
                      VerticalAlignment="Center"
                      Margin="0,10,0,0"/>
                <RadioButton IsChecked="{Binding OneFolder}" 
                      Content="Tout dans un seul dossier" 
                      Grid.Row="4"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      VerticalAlignment="Center"
                      Margin="0,10,0,0"/>

            </StackPanel>


            <Button Grid.Row="5"
                 Grid.ColumnSpan="3"
                 Margin="10"
                 Content="Déplacer les fichiers"
                 Style="{StaticResource MaterialDesignFlatButton}"
                 Command="{Binding MoveFilesCommand}"
                 HorizontalAlignment="Right"
                 Padding="10,5"/>
        </Grid>
       



    </Grid>
</UserControl>
